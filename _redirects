# ============================================================
# Cloudflare Pages - Reglas de redirección (_redirects)
# ============================================================
# NOTA: Cloudflare Pages ya sirve index.html en la raíz "/"
# automáticamente, por lo que NO se necesita una regla para "/".

# --- Rutas principales (sin extensión -> archivo .html) ---
/login  /login.html  200
/home   /home.html  200
/wadmina  /wadmina.html  200

# --- Directorios de recursos (servir directamente) ---
/home_files/*  /home_files/:splat  200
/login_files/*  /login_files/:splat  200
